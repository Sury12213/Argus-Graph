# Argus-Graph API environment template
# Copy to apps/api/.env and replace placeholders. Do not commit real secrets.

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://argus:argus_secret@localhost:5433/argus_graph?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=replace-with-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI provider
GROQ_API_KEY=replace-with-groq-api-key
AI_MODEL=llama-3.1-8b-instant

# Solana RPC and on-chain data
HELIUS_API_KEY=replace-with-helius-api-key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Twitter/X data via RapidAPI twitter-api45
RAPIDAPI_KEY=replace-with-rapidapi-key

# Telegram alerts
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-default-chat-id
TELEGRAM_BOT_USERNAME=replace-with-bot-username

