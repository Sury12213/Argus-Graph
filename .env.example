# ============================================
# Argus-Graph v3.0 — Environment Variables
# Copy this file to apps/api/.env and fill in your values
# ============================================

# Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://argus:argus_secret@localhost:5433/argus_graph?schema=public"

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Gemini AI (Free tier — https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Solana RPC (uses mock data in dev — no key needed)
HELIUS_API_KEY=your-helius-api-key-here
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
